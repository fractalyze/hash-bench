# bazel 9 defaults to bzlmod (WORKSPACE is gone), so no enable flags needed.
build --announce_rc
test --test_output=errors

# The suite is a harness test suite, not a measurement: it asserts that rows are
# produced, classified and modelled correctly. It runs on CPU only — this pins
# the backend, and `sweep_test` asks the driver for the CPU leg — so it is
# deterministic on any machine and covers no GPU-specific routing. The sweep
# itself picks its backends from `--backend`, never from here.
test --test_env=FRX_PLATFORMS=cpu

# Never let Bazel synthesize an `__init__.py` into a runfiles tree (it can write
# an empty one back through a source symlink; `hash_frx`'s .bazelrc carries the
# full account).
build --incompatible_default_to_explicit_init_py

# The Plonky3 reference measures a packed field, and which one it gets is a
# `target_feature` gate read when EACH crate compiles. Setting the features on
# the shim alone leaves `KoalaBear::Packing` as whatever `p3-monty-31` resolved
# it to — its own build having seen no features — so the shim compiles against
# a scalar packing and quietly measures one permutation at a time. The flags
# therefore belong to the whole Rust build, which here is exactly that shim and
# its pinned crates. `plonky3_shim` reports the packing width it actually got,
# so a build where this failed to apply says so in the row rather than claiming
# AVX-512.
# One feature per flag: the list-valued setting splits on commas, which would
# hand rustc `+avx512vl` as an input filename. `-Ctarget-feature` accumulates
# across repeats.
build --@rules_rust//rust/settings:extra_rustc_flag=-Copt-level=3
build --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-feature=+avx512f
build --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-feature=+avx512vl
build --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-feature=+avx512bw
build --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-feature=+avx512dq

# Local, machine-specific overrides (gitignored).
try-import %workspace%/.bazelrc.user
