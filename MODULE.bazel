"""hash-bench — the hash benchmark harness.

bzlmod module. The two things being measured arrive as pinned dependencies
rather than as whatever happens to be installed: `hash_frx` as a bzlmod module
at a commit, and the frx wheels (which carry the Fractalyze XLA plugin) from
the lock. A row records both, so a table is reproducible from the row alone.

The frx pins here must equal `hash_frx`'s own, not merely satisfy its floor: a
bzlmod consumer resolves each module's pip dependencies from its own lock, and
only equal versions keep ONE frx and ONE zk_dtypes on a test's `sys.path`.
Bumping the `git_override` commit therefore means copying that commit's
`requirements_lock_3_11.txt` over this one.
"""

module(
    name = "hash_bench",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.5.1")
bazel_dep(name = "hash_frx", version = "0.0.0")
git_override(
    module_name = "hash_frx",
    commit = "7313e13079afbf585a232e22986d184f8f5e89eb",
    remote = "https://github.com/fractalyze/hash-frx.git",
)

# The CPU reference implementations. Each is a pinned external dependency at a
# fixed revision rather than a vendored copy, because the revision is part of
# what a measured row claims: a reference number is only comparable to another
# run's if both name the same source. `hash_bench/reference/BUILD.bazel` records
# the build flags each one is compiled with, which is the other half of that
# claim.
#
# BLAKE3 and OpenSSL arrive through the Bazel Central Registry, which already
# carries a native build of each. XKCP ships no Bazel build, so it is fetched at
# a commit with the overlay in `third_party/`.
bazel_dep(name = "blake3", version = "1.8.2.bcr.1")
bazel_dep(name = "openssl", version = "4.0.1.bcr.0")
bazel_dep(name = "rules_rust", version = "0.74.0")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

# A commit, not a tag: XKCP publishes no releases.
http_archive(
    name = "xkcp",
    build_file = "//third_party:xkcp.BUILD",
    integrity = "sha256-zwDpBT22n2cNE3WzDfeHwe+Rvc+5uHC9+jeQ3+10ODY=",
    strip_prefix = "XKCP-eb5244d6b95fb1c434b211bac293093e18aa8fd1",
    urls = ["https://github.com/XKCP/XKCP/archive/eb5244d6b95fb1c434b211bac293093e18aa8fd1.tar.gz"],
)

# Plonky3 is Rust, so the reference for Poseidon2 needs a toolchain the other
# three do not. Pinned like everything else here: a row measured against
# another rustc is a different number.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.96.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "p3-koala-bear",
    version = "=0.7.0",
)
crate.spec(
    package = "p3-symmetric",
    version = "=0.7.0",
)
crate.spec(
    package = "p3-field",
    version = "=0.7.0",
)
crate.spec(
    package = "rayon",
    version = "=1.10.0",
)
crate.from_specs(name = "hash_bench_crates")
use_repo(crate, "hash_bench_crates")

# The GPU references are CUDA, compiled by a toolkit fetched from NVIDIA's
# redistributable archive at a fixed release rather than by whichever nvcc the
# host has installed: a kernel built by another nvcc is a different program, so
# the toolkit is pinned the way every upstream revision is.
bazel_dep(name = "rules_cuda", version = "0.3.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_redist",
    components = [
        "cccl",
        "cudart",
        "nvcc",
    ],
    version = "12.9.1",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

# OpenVM's KoalaBear Poseidon2 kernel, the GPU reference for Poseidon2, at the
# v2.0.1 tag's commit. The patch moves its constants to p3-koala-bear 0.7.0, the
# release hash-frx computes; the `openvm` note in hash_bench/reference/BUILD.bazel,
# which every row carries, says what it changes and why the work does not.
http_archive(
    name = "openvm_stark_backend",
    build_file = "//third_party:openvm_stark_backend.BUILD",
    integrity = "sha256-VLRmMN4Env8sW9eIBINCcH3Xv8RRmRDezyDJh8/UVvU=",
    patch_args = ["-p1"],
    patches = ["//third_party:openvm_poseidon2_kb_plonky3_0_7_0.patch"],
    strip_prefix = "stark-backend-362c7ad8c6b042b320471a137e3eadec7ec69a44",
    urls = ["https://github.com/openvm-org/stark-backend/archive/362c7ad8c6b042b320471a137e3eadec7ec69a44.tar.gz"],
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    # frx / frxlib / frx-cuda12-pjrt / frx-cuda12-plugin are published on the
    # Fractalyze index.
    extra_pip_args = ["--extra-index-url=https://fractalyze.github.io/pypi/simple/"],
    hub_name = "hash_bench_pip",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock_3_11.txt",
)
use_repo(pip, "hash_bench_pip")
